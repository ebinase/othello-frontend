{
  "name": "othello-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.17.0",
    "npm": ">=11.20.0 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write --ignore-path .gitignore './**/*.{js,jsx,ts,tsx,json,css}'",
    "check:types": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/analytics": "1.3.2",
    "jotai": "2.9.2",
    "next": "15.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-pattern": "5.2.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.1",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "8.8.0",
    "postcss": "8.5.30",
    "prettier": "2.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.5.4",
    "@tailwindcss/postcss": "4.3.3"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss",
      "sharp": "0.35.5"
    }
  },
  "packageManager": "npm@11.20.0",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.20.0 <12",
      "onFail": "error"
    }
  }
}
