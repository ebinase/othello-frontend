{
  "name": "othello-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write --ignore-path .gitignore './**/*.{js,mjs,mts,jsx,ts,tsx,json,css,html}'",
    "check:types": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vercel/analytics": "1.3.2",
    "jotai": "2.9.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-pattern": "5.2.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.1",
    "eslint": "10.13.0",
    "postcss": "8.5.30",
    "prettier": "2.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "@tailwindcss/postcss": "4.3.3",
    "@typescript-eslint/parser": "8.71.2",
    "@vitejs/plugin-react": "6.1.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "vite": "8.3.4"
  },
  "packageManager": "npm@11.19.1"
}
